#include <windows.h>

#include "version.h"

// exe に埋め込むアイコン。make_icon.py が音符から書き出したものをそのまま使う。
1 ICON "../muutask.ico"

VS_VERSION_INFO VERSIONINFO
FILEVERSION 0, 0, 0, MUUTASK_VERSION_NUM
PRODUCTVERSION 0, 0, 0, MUUTASK_VERSION_NUM
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "041104b0"
        BEGIN
            VALUE "FileDescription", "MuuTask"
            VALUE "FileVersion", MUUTASK_VERSION
            VALUE "InternalName", "MuuTask"
            VALUE "OriginalFilename", "MuuTask.exe"
            VALUE "ProductName", "MuuTask"
            VALUE "ProductVersion", MUUTASK_VERSION
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x411, 1200
    END
END
